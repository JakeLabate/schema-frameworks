      "@type": "Recipe",
      "@id": "https://www.example.com/journal/one-pot-camp-chili/#recipe",
      "name": "One-Pot Camp Chili",
      "description": "A smoky bean and beef chili that cooks in one pot over a camp stove, ready in under an hour.",
      "image": [
        "https://www.example.com/img/journal/camp-chili-1x1.jpg",
        "https://www.example.com/img/journal/camp-chili-4x3.jpg",
        "https://www.example.com/img/journal/camp-chili-16x9.jpg"
      ],
      "author": {
        "@id": "https://www.example.com/journal/authors/maya-okafor/#person"
      },
      "publisher": {
        "@id": "https://www.example.com/#organization"
      },
      "datePublished": "2026-08-21",
      "prepTime": "PT15M",
      "cookTime": "PT40M",
      "totalTime": "PT55M",
      "recipeYield": [
        "4",
        "4 servings"
      ],
      "recipeCategory": "Main course",
      "recipeCuisine": "American",
      "keywords": "camp cooking, one pot, backpacking",
      "recipeIngredient": [
        "1 lb ground beef",
        "1 onion, diced",
        "2 cloves garlic, minced",
        "2 tbsp chili powder",
        "1 tsp smoked paprika",
        "1 can (15 oz) black beans, drained",
        "1 can (15 oz) crushed tomatoes",
        "1 cup water",
        "Salt to taste"
      ],
      "recipeInstructions": [
        {
          "@type": "HowToStep",
          "name": "Brown the beef",
          "text": "Brown the beef in the pot over medium heat, then pour off most of the fat.",
          "url": "https://www.example.com/journal/one-pot-camp-chili/#step-1"
        },
        {
          "@type": "HowToStep",
          "name": "Soften the onion",
          "text": "Add the onion and garlic and cook for five minutes until soft.",
          "url": "https://www.example.com/journal/one-pot-camp-chili/#step-2"
        },
        {
          "@type": "HowToStep",
          "name": "Add spices and simmer",
          "text": "Stir in the spices, beans, tomatoes and water, cover and simmer for thirty minutes.",
          "url": "https://www.example.com/journal/one-pot-camp-chili/#step-3"
        },
        {
          "@type": "HowToStep",
          "name": "Season and serve",
          "text": "Season with salt, rest for five minutes off the heat and serve.",
          "url": "https://www.example.com/journal/one-pot-camp-chili/#step-4"
        }
      ],
