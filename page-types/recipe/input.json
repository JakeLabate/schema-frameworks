    "ingredients": [
      "1 lb ground beef",
      "1 onion, diced",
      "2 cloves garlic, minced",
      "2 tbsp chili powder",
      "1 tsp smoked paprika",
      "1 can (15 oz) black beans, drained",
      "1 can (15 oz) crushed tomatoes",
      "1 cup water",
      "Salt to taste"
