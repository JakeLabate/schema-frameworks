{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to replace a bike chain",
  "description": "Swap a worn 11-speed chain with a chain tool and a quick link.",
  "image": "https://www.example.com/guides/replace-bike-chain/hero.jpg",
  "totalTime": "PT25M",
  "supply": [
    {
      "@type": "HowToSupply",
      "name": "11-speed chain"
    },
    {
      "@type": "HowToSupply",
      "name": "Quick link"
    }
  ],
  "tool": [
    {
      "@type": "HowToTool",
      "name": "Chain tool"
    },
    {
      "@type": "HowToTool",
      "name": "Chain checker"
    }
  ],
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Check wear",
      "text": "Measure the old chain with a chain checker; replace it at 0.5% stretch.",
      "url": "https://www.example.com/guides/replace-bike-chain#step-1"
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Remove the old chain",
      "text": "Open the quick link or push out a pin with the chain tool.",
      "url": "https://www.example.com/guides/replace-bike-chain#step-2"
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Size and fit the new chain",
      "text": "Match the old chain length, thread it through the derailleur and close the quick link.",
      "url": "https://www.example.com/guides/replace-bike-chain#step-3",
      "image": "https://www.example.com/guides/replace-bike-chain/quick-link.jpg"
    }
  ]
}
