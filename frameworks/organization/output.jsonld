        "@id": "https://www.example.com/rewards#summit",
        "name": "Summit",
        "hasTierBenefit": [
          "https://schema.org/TierBenefitLoyaltyPoints",
          "https://schema.org/TierBenefitLoyaltyPrice"
        ],
        "hasTierRequirement": {
          "@type": "MonetaryAmount",
          "value": 500,
          "currency": "USD"
        },
        "membershipPointsEarned": {
          "@type": "QuantitativeValue",
          "value": 2
        }
      }
    ]
