              "MA"
            ]
          },
          "orderValue": {
            "@type": "MonetaryAmount",
            "currency": "USD",
            "minValue": 0,
            "maxValue": 74.99
          },
          "shippingRate": {
            "@type": "MonetaryAmount",
            "currency": "USD",
            "value": 7.95
          },
          "transitTime": {
            "@type": "ServicePeriod",
            "duration": {
              "@type": "QuantitativeValue",
              "minValue": 3,
